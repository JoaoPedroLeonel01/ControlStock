# Environment variables template for ControlStock
# Duplicate this file as .env for local development: cp .env.example .env

# Local PostgreSQL container (read by docker-compose.yml)
POSTGRES_USER=control_stock_user
POSTGRES_PASSWORD=control_stock_pass
POSTGRES_DB=control_stock
POSTGRES_PORT=5432

# Database connection URI (required by the application and Alembic).
# Must match the values above when using Docker Compose.
# URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg://control_stock_user:control_stock_pass@localhost:5432/control_stock

# Application settings
ENVIRONMENT=development
PORT=8000
